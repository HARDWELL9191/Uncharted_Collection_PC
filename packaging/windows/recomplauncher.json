{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Uncharted: The Nathan Drake Collection PC",
  "repo": "zorde23/Uncharted_Collection_PC",
  "game": {
    "kind": "folder",
    "label": "The folder of your own PS4 dump of Uncharted: The Nathan Drake Collection (CUSA02344, CUSA02320, CUSA02826...). The 01.02 update can sit next to it (CUSA02344-UPDATE) or be merged in.",
    "check": {
      "file": "big3-ps4_Shipping.elf"
    },
    "update": {
      "into": "update",
      "accepts": "folder",
      "optional": true,
      "label": "The 01.02 update folder (like CUSA02344-UPDATE or CUSA02344-patch), when it is separate from the game. Skip it if your dump already has the update merged in, or if the update sits next to the game folder."
    }
  },
  "start": {
    "program": [
      "Uncharted Launcher.exe"
    ],
    "args": [
      "--play",
      "--game",
      "{game}",
      "uc1"
    ]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {
          "path": "{install}/ucndc.ini"
        }
      ],
      "new": {
        "display_mode": "windowed",
        "vsync": "1",
        "fps_limit": "0",
        "async_shaders": "1",
        "frames_queued": "1",
        "deferred_readback": "1",
        "stale_readback": "0",
        "show_fps": "1",
        "overlay_fps": "1"
      }
    },
    {
      "id": "input",
      "format": "ini",
      "file": [
        {
          "path": "{install}/input.ini"
        }
      ]
    },
    {
      "id": "launcher",
      "format": "json",
      "file": [
        {
          "path": "{install}/launcher.json"
        }
      ]
    }
  ],
  "settings": [
    {
      "id": "title",
      "label": "Game",
      "in": "args",
      "help": "Which game Play starts. Uncharted 1 opens the collection menu first, where you can pick any of the three. Port launcher opens the port's own window instead.",
      "choices": [
        {
          "label": "Uncharted 1",
          "args": [
            "uc1"
          ]
        },
        {
          "label": "Uncharted 2",
          "args": [
            "uc2"
          ]
        },
        {
          "label": "Uncharted 3",
          "args": [
            "uc3"
          ]
        },
        {
          "label": "Port launcher",
          "args": [
            "--window"
          ]
        }
      ]
    },
    {
      "id": "resolution",
      "label": "Resolution",
      "help": "What the game draws at. 1080p is the PS4's own; 1440p and 4K need more video memory.",
      "choices": [
        {
          "label": "720p",
          "set": {
            "resolution": "\"720\""
          }
        },
        {
          "label": "900p",
          "set": {
            "resolution": "\"900\""
          }
        },
        {
          "label": "1080p",
          "set": {
            "resolution": "\"1080\""
          }
        },
        {
          "label": "1440p",
          "set": {
            "resolution": "\"1440\""
          }
        },
        {
          "label": "4K",
          "set": {
            "resolution": "\"2160\""
          }
        }
      ],
      "in": "launcher",
      "defaults": {
        "resolution": "\"1080\""
      }
    },
    {
      "id": "display_mode",
      "label": "Window",
      "choices": [
        {
          "label": "Window",
          "set": {
            "display_mode": "windowed"
          }
        },
        {
          "label": "Borderless",
          "set": {
            "display_mode": "borderless"
          }
        },
        {
          "label": "Fullscreen",
          "set": {
            "display_mode": "fullscreen"
          }
        }
      ],
      "defaults": {
        "display_mode": "windowed"
      }
    },
    {
      "id": "vsync",
      "label": "V-Sync",
      "choices": [
        {
          "label": "On",
          "set": {
            "vsync": "1"
          }
        },
        {
          "label": "Off",
          "set": {
            "vsync": "0"
          }
        }
      ],
      "defaults": {
        "vsync": "1"
      }
    },
    {
      "id": "fps_limit",
      "label": "Frame rate",
      "help": "The games run at 60. 30 is the PS3's rate.",
